# =============================================================================
# .gitignore — Monorepo: Java Spring Boot Backend + Next.js Frontend
# =============================================================================

# =============================================================================
# ██████  Java / Maven / Spring Boot (Backend)
# =============================================================================

# Maven build output
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Maven settings override (should not be committed)
.mvn/jvm.config

# Compiled class files
*.class

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Spring Boot DevTools restart trigger
.reloadtrigger

# Spring Boot packaging helpers
spring-boot-docker-compose.yaml

# STS (Spring Tool Suite)
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse
.eclipse
.metadata
bin/
tmp/
*.tmp
*.bak
*.swp
*~.nib
local.properties
.settings/
.loadpath
.recommenders
.externalToolBuilders/
*.launch
.factorypath

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# Checkstyle
checkstyle-result.xml

# =============================================================================
# ██████  Node.js / npm / Next.js (Frontend)
# =============================================================================

# Dependencies
frontend/node_modules/
node_modules/

# Next.js build output
frontend/.next/
frontend/out/
frontend/build/
.next/
out/
build/

# Next.js cache
frontend/.swc/

# Vercel deployment
.vercel/
frontend/.vercel/

# Turbopack cache
.turbo/
frontend/.turbo/

# Production bundles (already in .next)
frontend/dist/

# =============================================================================
# ██████  Environment Variables & Secrets
# =============================================================================

# All .env files — NEVER commit secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.test
!.env.local.example

# Specific env files
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging
.env.production
.env.secrets

# =============================================================================
# ██████  Editors & IDEs
# =============================================================================

# VS Code (keep workspace settings, ignore local overrides)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
!.vscode/launch.json.example

# Cursor AI
.cursor/

# JetBrains (IntelliJ, WebStorm, etc.) — already covered but explicit
*.iml
*.iws
*.ipr

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist
Session.vim

# Emacs
\#*\#
.\#*

# MacOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptsnoop
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
.directory
.Trash-*

